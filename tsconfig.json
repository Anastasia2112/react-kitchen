{
  "files": [],
  "compilerOptions": {
    "target": "ES2020",
    "types": ["vite-plugin-svgr/client"],
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@entities/*": ["src/entities/*"],
      "@features/*": ["src/features/*"],
      "@pages/*": ["src/pages/*"],
      "@shared/*": ["src/shared/*"],
      "@widgets/*": ["src/widgets/*"]
    },
    "moduleResolution": "bundler",
    /* Bundler mode */
    "jsx": "react-jsx",
    /* Linting */
    "strict": true
  },
  "include": ["src"],
  "exclude": ["./node_modules", "./.git", "./dist"]
}
